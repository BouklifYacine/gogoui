{
  "name": "@gogoui/ui",
  "version": "0.0.0",
  "description": "GoGoUI's React components: shadcn conventions on Base UI, Tailwind CSS 4, light and dark, accessible (WCAG AA).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BouklifYacine/gogoui.git",
    "directory": "packages/ui"
  },
  "keywords": [
    "react",
    "design-system",
    "components",
    "tailwindcss",
    "base-ui",
    "shadcn"
  ],
  "files": [
    "dist",
    "styles.css",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "imports": {
    "#*": [
      "./*",
      "./*.ts",
      "./*.tsx"
    ]
  },
  "exports": {
    "./styles.css": "./styles.css",
    "./provider": {
      "types": "./dist/i18n/index.d.ts",
      "default": "./dist/i18n/index.js"
    },
    "./cn": {
      "types": "./dist/lib/cn.d.ts",
      "default": "./dist/lib/cn.js"
    },
    "./*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@phosphor-icons/react": "^2.1.0",
    "cmdk": "^1.1.0",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0",
    "tailwindcss": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "cmdk": {
      "optional": true
    },
    "react-day-picker": {
      "optional": true
    },
    "recharts": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@gogoui/tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "motion": "^14.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@storybook/addon-a11y": "11.0.0-beta.3",
    "@storybook/addon-docs": "11.0.0-beta.3",
    "@storybook/addon-mcp": "11.0.0-beta.3",
    "@storybook/addon-themes": "11.0.0-beta.3",
    "@storybook/react-vite": "11.0.0-beta.3",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cmdk": "^1.1.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "recharts": "^3.8.0",
    "storybook": "11.0.0-beta.3",
    "tailwindcss": "^4.3.5",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}

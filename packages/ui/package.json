{
  "name": "@gogoui/ui",
  "version": "0.3.0",
  "description": "GoGoUI's React components: shadcn conventions on Base UI, Tailwind CSS 4, light and dark, accessible (WCAG AA).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BouklifYacine/gogoui.git",
    "directory": "packages/ui"
  },
  "keywords": [
    "react",
    "design-system",
    "components",
    "tailwindcss",
    "base-ui",
    "shadcn"
  ],
  "files": [
    "dist",
    "styles.css",
    "tokens.css",
    "theme.css",
    "themes",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "imports": {
    "#*": [
      "./*",
      "./*.ts",
      "./*.tsx"
    ]
  },
  "exports": {
    "./styles.css": "./styles.css",
    "./tokens.css": "./tokens.css",
    "./theme.css": "./theme.css",
    "./themes/*": "./themes/*",
    "./theme": {
      "types": "./dist/theme/create-theme.d.ts",
      "default": "./dist/theme/create-theme.js"
    },
    "./provider": {
      "types": "./dist/i18n/index.d.ts",
      "default": "./dist/i18n/index.js"
    },
    "./locales/fr": {
      "types": "./dist/i18n/locales/fr.d.ts",
      "default": "./dist/i18n/locales/fr.js"
    },
    "./locales/en": {
      "types": "./dist/i18n/locales/en.d.ts",
      "default": "./dist/i18n/locales/en.js"
    },
    "./cn": {
      "types": "./dist/lib/cn.d.ts",
      "default": "./dist/lib/cn.js"
    },
    "./data-table": {
      "types": "./dist/data-table/index.d.ts",
      "default": "./dist/data-table/index.js"
    },
    "./tanstack-form": {
      "types": "./dist/tanstack-form/index.d.ts",
      "default": "./dist/tanstack-form/index.js"
    },
    "./*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@phosphor-icons/react": "^2.1.0",
    "@tanstack/react-form": "^1.0.0",
    "@tanstack/react-table": "^9.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "cmdk": "^1.1.0",
    "embla-carousel-react": "^8.0.0",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^20.0.0",
    "react-joyride": "^3.0.0",
    "react-resizable-panels": "^4.0.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.0",
    "tailwindcss": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-form": {
      "optional": true
    },
    "@tanstack/react-table": {
      "optional": true
    },
    "@tiptap/extension-placeholder": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "cmdk": {
      "optional": true
    },
    "embla-carousel-react": {
      "optional": true
    },
    "react-day-picker": {
      "optional": true
    },
    "react-dropzone": {
      "optional": true
    },
    "react-joyride": {
      "optional": true
    },
    "react-resizable-panels": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "sonner": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "country-flag-icons": "1.6.20",
    "motion": "^14.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@size-limit/preset-small-lib": "14.3.0",
    "@storybook/addon-a11y": "11.0.0-beta.5",
    "@storybook/addon-docs": "11.0.0-beta.5",
    "@storybook/addon-mcp": "11.0.0-beta.5",
    "@storybook/addon-themes": "11.0.0-beta.5",
    "@storybook/addon-vitest": "11.0.0-beta.5",
    "@storybook/react-vite": "11.0.0-beta.5",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-table": "^9.3.1",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "5.1.1",
    "@vitest/browser-playwright": "5.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-joyride": "^3.2.0",
    "react-resizable-panels": "^4.24.0",
    "recharts": "^3.8.0",
    "size-limit": "14.3.0",
    "sonner": "^2.0.8",
    "storybook": "11.0.0-beta.5",
    "tailwindcss": "^4.3.5",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "5.1.1"
  }
}
